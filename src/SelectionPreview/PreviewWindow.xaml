<Window x:Class="SelectionPreview.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="划词预览" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Width="1" Height="1" Left="0" Top="0" UseLayoutRounding="True">
    <Border x:Name="Card" Margin="1" BorderThickness="1" CornerRadius="8" Padding="12,8"
            SnapsToDevicePixels="True">
        <TextBlock x:Name="Body" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" LineHeight="20"
                   LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
    </Border>
</Window>
