<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Preview.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SelectionPreview.Dictionary\SelectionPreview.Dictionary.csproj" />
    <ProjectReference Include="..\SelectionPreview.Core\SelectionPreview.Core.csproj" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <EmbeddedResource Include="Preview.ico" LogicalName="SelectionPreview.Preview.ico" />
  </ItemGroup>
</Project>
